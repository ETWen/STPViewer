<Window x:Class="STPViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:conv="clr-namespace:STPViewer.Converters"
        xmlns:vm="clr-namespace:STPViewer.ViewModels"
        xmlns:loc="clr-namespace:STPViewer.Localization"
        Title="{loc:Loc Ui.Main.WindowTitle}"
        Height="820" Width="1320"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:EnumToBoolConverter x:Key="ModeConv" />
        <conv:FileNameConverter x:Key="FileNameConv" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ModeButton" TargetType="ToggleButton">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="QuickButton" TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ─── 選單列（全部功能，分類下拉）─── -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{loc:Loc Ui.Main.FileF}">
                <MenuItem Header="{loc:Loc Ui.Main.MenuImport}" Command="{Binding ImportCommand}"
                          ToolTip="{loc:Loc Ui.Main.ImportSTPSTEPSTLDXFFiles}" />
                <MenuItem Header="{loc:Loc Ui.Main.RecentFiles}" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Converter={StaticResource FileNameConv}}" />
                            <Setter Property="ToolTip" Value="{Binding}" />
                            <Setter Property="Command"
                                    Value="{Binding DataContext.ImportRecentCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="{loc:Loc Ui.Main.ExportMeasurementsCSV}" Command="{Binding ExportCsvCommand}" />
                <MenuItem Header="{loc:Loc Ui.Main.SaveViewPNG}" Command="{Binding SaveScreenshotCommand}"
                          ToolTip="{loc:Loc Ui.Main.SavePNGScreenshot3DView2}" />
                <MenuItem Header="{loc:Loc Ui.Main.ExportSTEP}" Command="{Binding ExportStepFileCommand}"
                          ToolTip="{loc:Loc Ui.Main.ExportStepTooltip}" />
                <MenuItem Header="{loc:Loc Ui.Main.ExportSTL}" Command="{Binding ExportStlFileCommand}"
                          ToolTip="{loc:Loc Ui.Main.ChooseScopeFormatUnitsMeshQuality}" />
            </MenuItem>
            <MenuItem Header="{loc:Loc Ui.Main.ViewV}">
                <MenuItem Header="{loc:Loc Ui.Main.ZoomFit}" Command="{Binding ZoomAllCommand}" />
                <Separator />
                <MenuItem Header="{loc:Loc Ui.Main.IsometricView}" Command="{Binding SetStandardViewCommand}" CommandParameter="Iso" />
                <MenuItem Header="{loc:Loc Ui.Main.FrontView}" Command="{Binding SetStandardViewCommand}" CommandParameter="Front"
                          ToolTip="{loc:Loc Ui.Main.LookAlongYZUp}" />
                <MenuItem Header="{loc:Loc Ui.Main.TopView}" Command="{Binding SetStandardViewCommand}" CommandParameter="Top"
                          ToolTip="{loc:Loc Ui.Main.LookDownFromZ}" />
                <MenuItem Header="{loc:Loc Ui.Main.RightView}" Command="{Binding SetStandardViewCommand}" CommandParameter="Right"
                          ToolTip="{loc:Loc Ui.Main.LookAlongXZUp}" />
                <Separator />
                <MenuItem Header="{loc:Loc Ui.Main.OrthographicProjection}" IsCheckable="True" IsChecked="{Binding OrthographicView}"
                          ToolTip="{loc:Loc Ui.Main.ParallelProjectionAvoidsPerspectiveDistortionUncheck}" />
                <MenuItem Header="{loc:Loc Ui.Main.DisplayInchesMm}" IsCheckable="True" IsChecked="{Binding UseInch}"
                          ToolTip="{loc:Loc Ui.Main.ExistingMeasurementsUpdateImmediatelyValuesStored}" />
                <Separator />
                <MenuItem Header="{loc:Loc Ui.Language}" ItemsSource="{Binding Languages}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Key}" />
                            <Setter Property="IsCheckable" Value="True" />
                            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                            <Setter Property="Command"
                                    Value="{Binding DataContext.ChangeLanguageCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                            <Setter Property="CommandParameter" Value="{Binding Id}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{loc:Loc Ui.Main.MeasureM}">
                <MenuItem Header="{loc:Loc Ui.Main.PointCoordinates}" IsCheckable="True" InputGestureText="P"
                          IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Point}"
                          ToolTip="{loc:Loc Ui.Main.MeasurePointCoordinatesSnapsVerticesCircle}" />
                <MenuItem Header="{loc:Loc Ui.Main.TwoPointDistance}" IsCheckable="True" InputGestureText="D"
                          IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Distance}"
                          ToolTip="{loc:Loc Ui.Main.DistanceXYZCircularEdgesSnapCenters}" />
                <MenuItem Header="{loc:Loc Ui.Main.EdgeLength}" IsCheckable="True" InputGestureText="E"
                          IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Edge}"
                          ToolTip="{loc:Loc Ui.Main.MeasureStraightCurvedCircularEdgeLengths}" />
                <MenuItem Header="{loc:Loc Ui.Main.Face}" IsCheckable="True" InputGestureText="F"
                          IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Face}"
                          ToolTip="{loc:Loc Ui.Main.AreaSurfaceTypeNormalVector}" />
                <MenuItem Header="{loc:Loc Ui.Main.Circle}" IsCheckable="True" InputGestureText="C"
                          IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Circle}"
                          ToolTip="{loc:Loc Ui.Main.CenterRadiusDiameterCircumference}" />
                <MenuItem Header="{loc:Loc Ui.Main.Angle}" IsCheckable="True" InputGestureText="A"
                          IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Angle}"
                          ToolTip="{loc:Loc Ui.Main.AngleBetweenTwoFacesStraightEdges}" />
                <MenuItem Header="{loc:Loc Ui.Main.FaceDistance}" IsCheckable="True" InputGestureText="M"
                          IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=FaceDistance}"
                          ToolTip="{loc:Loc Ui.Main.ShortestDistanceBetweenFacesMeshApproximation}" />
                <Separator />
                <MenuItem Header="{loc:Loc Ui.Main.ClearAllMeasurements}" Command="{Binding ClearMeasurementsCommand}"
                          InputGestureText="Esc" ToolTip="{loc:Loc Ui.Main.EscCancelsCurrentMeasurementExitsMode}" />
            </MenuItem>
            <MenuItem Header="{loc:Loc Ui.Main.TransformT}">
                <MenuItem Header="{loc:Loc Ui.Main.TwoPointAlignmentTranslate}" IsCheckable="True"
                          IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Align}"
                          ToolTip="{loc:Loc Ui.Main.PickPointPartMoveThenPick}" />
                <MenuItem Header="{loc:Loc Ui.Main.ThreePointAlignmentRotateTranslate}" IsCheckable="True"
                          IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Align3}"
                          ToolTip="{loc:Loc Ui.Main.PickThreePointsMovingModelThen}" />
                <MenuItem Header="{loc:Loc Ui.Main.DragMode}" IsCheckable="True"
                          IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Drag}"
                          ToolTip="{loc:Loc Ui.Main.HoldLeftMouseButtonMovePart}" />
                <MenuItem Header="{loc:Loc Ui.Main.3AxisGizmo}" IsCheckable="True" IsChecked="{Binding GizmoEnabled}"
                          ToolTip="{loc:Loc Ui.Main.ShowXYZArrowsRotationRingsSelected}" />
                <Separator />
                <MenuItem Header="{loc:Loc Ui.Main.Rotate90AroundX}" Command="{Binding RotateRootCommand}" CommandParameter="X"
                          ToolTip="{loc:Loc Ui.Main.RotateModelSelectedTreeAroundIts}" />
                <MenuItem Header="{loc:Loc Ui.Main.Rotate90AroundY}" Command="{Binding RotateRootCommand}" CommandParameter="Y" />
                <MenuItem Header="{loc:Loc Ui.Main.Rotate90AroundZ}" Command="{Binding RotateRootCommand}" CommandParameter="Z" />
            </MenuItem>
            <MenuItem Header="{loc:Loc Ui.Main.ToolsL}">
                <MenuItem Header="{loc:Loc Ui.Main.InterferenceCheck}" Command="{Binding CheckInterferenceCommand}"
                          ToolTip="{loc:Loc Ui.Main.CheckVisibleModelPairsIntersectionsReport}" />
                <MenuItem Header="{loc:Loc Ui.Main.SectionView}" IsCheckable="True" IsChecked="{Binding SectionEnabled}"
                          ToolTip="{loc:Loc Ui.Main.ShowSectionControlsAxisPositionDirection}" />
            </MenuItem>
            <MenuItem Header="{loc:Loc Ui.Main.QuickBarQ}">
                <MenuItem Header="{loc:Loc Ui.Main.CustomizeButtons}" ItemsSource="{Binding QuickBar.Items}"
                          ToolTip="{loc:Loc Ui.Main.CheckButtonsShowQuickBarSaved}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Label}" />
                            <Setter Property="IsCheckable" Value="True" />
                            <Setter Property="IsChecked" Value="{Binding IsChecked}" />
                            <Setter Property="StaysOpenOnClick" Value="True" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="{loc:Loc Ui.Main.RestoreDefaultButtons}" Command="{Binding QuickBar.ResetDefaultsCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Loc Ui.Main.HelpH}">
                <MenuItem Header="{loc:Loc Ui.Main.IAboutSTPViewer}" Click="About_Click"
                          ToolTip="{loc:Loc Ui.Main.ApplicationInformationReleaseHistory}" />
            </MenuItem>
        </Menu>

        <!-- ─── 快速工具列（可自訂：選單「快速列 → 自訂按鈕」勾選）─── -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Style="{StaticResource QuickButton}" Command="{Binding ImportCommand}"
                        Visibility="{Binding QuickBar[Import].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.ImportSTPSTEPSTLDXFFiles}" Content="{loc:Loc Ui.Main.ToolbarImport}" />
                <Button Style="{StaticResource QuickButton}" Click="Recent_Click" Padding="4,4"
                        Visibility="{Binding QuickBar[Recent].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.RecentlyOpenedFiles}">▾</Button>
                <Button Style="{StaticResource QuickButton}" Command="{Binding ZoomAllCommand}"
                        Visibility="{Binding QuickBar[ZoomAll].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.FitAllModelsView}" Content="{loc:Loc Ui.Main.Fit}" />
                <Button Style="{StaticResource QuickButton}" Command="{Binding SetStandardViewCommand}" CommandParameter="Iso"
                        Visibility="{Binding QuickBar[ViewIso].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.IsometricView}" Content="{loc:Loc Ui.Main.Iso}" />
                <Button Style="{StaticResource QuickButton}" Command="{Binding SetStandardViewCommand}" CommandParameter="Front"
                        Visibility="{Binding QuickBar[ViewFront].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.FrontViewLookAlongYZ}" Content="{loc:Loc Ui.Main.Front}" />
                <Button Style="{StaticResource QuickButton}" Command="{Binding SetStandardViewCommand}" CommandParameter="Top"
                        Visibility="{Binding QuickBar[ViewTop].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.TopViewLookDownFromZ}" Content="{loc:Loc Ui.Main.Top}" />
                <Button Style="{StaticResource QuickButton}" Command="{Binding SetStandardViewCommand}" CommandParameter="Right"
                        Visibility="{Binding QuickBar[ViewRight].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.RightViewLookAlongXZ}" Content="{loc:Loc Ui.Main.Right}" />
                <ToggleButton Style="{StaticResource ModeButton}" IsChecked="{Binding OrthographicView}"
                              Visibility="{Binding QuickBar[Ortho].IsChecked, Converter={StaticResource BoolToVis}}"
                              ToolTip="{loc:Loc Ui.Main.OrthographicProjectionAvoidsPerspectiveDistortionClick}" Content="{loc:Loc Ui.Main.Ortho}" />
                <ToggleButton Style="{StaticResource ModeButton}" ToolTip="{loc:Loc Ui.Main.PointCoordinatesVertexCircleCenterSnapping}"
                              Visibility="{Binding QuickBar[Point].IsChecked, Converter={StaticResource BoolToVis}}"
                              IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Point}" Content="{loc:Loc Ui.Main.Point}" />
                <ToggleButton Style="{StaticResource ModeButton}" ToolTip="{loc:Loc Ui.Main.DistanceXYZCircleCenterSnappingHole}"
                              Visibility="{Binding QuickBar[Distance].IsChecked, Converter={StaticResource BoolToVis}}"
                              IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Distance}" Content="{loc:Loc Ui.Main.Distance}" />
                <ToggleButton Style="{StaticResource ModeButton}" ToolTip="{loc:Loc Ui.Main.StraightCurvedCircularEdgeLengthShortcut}"
                              Visibility="{Binding QuickBar[Edge].IsChecked, Converter={StaticResource BoolToVis}}"
                              IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Edge}" Content="{loc:Loc Ui.Main.Edge}" />
                <ToggleButton Style="{StaticResource ModeButton}" ToolTip="{loc:Loc Ui.Main.AreaSurfaceTypeNormalVectorShortcut}"
                              Visibility="{Binding QuickBar[Face].IsChecked, Converter={StaticResource BoolToVis}}"
                              IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Face}" Content="{loc:Loc Ui.Main.Face}" />
                <ToggleButton Style="{StaticResource ModeButton}" ToolTip="{loc:Loc Ui.Main.CenterRadiusDiameterCircumferenceShortcutC}"
                              Visibility="{Binding QuickBar[Circle].IsChecked, Converter={StaticResource BoolToVis}}"
                              IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Circle}" Content="{loc:Loc Ui.Main.Circle}" />
                <ToggleButton Style="{StaticResource ModeButton}" ToolTip="{loc:Loc Ui.Main.AngleBetweenFacesStraightEdgesShortcut}"
                              Visibility="{Binding QuickBar[Angle].IsChecked, Converter={StaticResource BoolToVis}}"
                              IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Angle}" Content="{loc:Loc Ui.Main.Angle}" />
                <ToggleButton Style="{StaticResource ModeButton}" ToolTip="{loc:Loc Ui.Main.ShortestFaceDistanceMeshApproximationShortcut}"
                              Visibility="{Binding QuickBar[FaceDistance].IsChecked, Converter={StaticResource BoolToVis}}"
                              IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=FaceDistance}" Content="{loc:Loc Ui.Main.FaceDistance}" />
                <ToggleButton Style="{StaticResource ModeButton}"
                              ToolTip="{loc:Loc Ui.Main.TwoPointAlignmentPickPointMoving}"
                              Visibility="{Binding QuickBar[Align].IsChecked, Converter={StaticResource BoolToVis}}"
                              IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Align}" Content="{loc:Loc Ui.Main.Align}" />
                <ToggleButton Style="{StaticResource ModeButton}"
                              ToolTip="{loc:Loc Ui.Main.ThreePointAlignmentPickThreePoints}"
                              Visibility="{Binding QuickBar[Align3].IsChecked, Converter={StaticResource BoolToVis}}"
                              IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Align3}" Content="{loc:Loc Ui.Main.3Point}" />
                <Button Style="{StaticResource QuickButton}" Command="{Binding RotateRootCommand}" CommandParameter="X"
                        Visibility="{Binding QuickBar[RotateX].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.RotateModelSelectedTree90Around}">↻X</Button>
                <Button Style="{StaticResource QuickButton}" Command="{Binding RotateRootCommand}" CommandParameter="Y"
                        Visibility="{Binding QuickBar[RotateY].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.RotateSelectedModel90AroundY}">↻Y</Button>
                <Button Style="{StaticResource QuickButton}" Command="{Binding RotateRootCommand}" CommandParameter="Z"
                        Visibility="{Binding QuickBar[RotateZ].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.RotateSelectedModel90AroundZ}">↻Z</Button>
                <ToggleButton Style="{StaticResource ModeButton}"
                              ToolTip="{loc:Loc Ui.Main.DragModeHoldLeftMouseButton}"
                              Visibility="{Binding QuickBar[Drag].IsChecked, Converter={StaticResource BoolToVis}}"
                              IsChecked="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Drag}" Content="{loc:Loc Ui.Main.Drag}" />
                <ToggleButton Style="{StaticResource ModeButton}" IsChecked="{Binding GizmoEnabled}"
                              Visibility="{Binding QuickBar[Gizmo].IsChecked, Converter={StaticResource BoolToVis}}"
                              ToolTip="{loc:Loc Ui.Main.3AxisGizmoUseXYZArrows}" Content="{loc:Loc Ui.Main.Gizmo}" />
                <Button Style="{StaticResource QuickButton}" Command="{Binding CheckInterferenceCommand}"
                        Visibility="{Binding QuickBar[Interference].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.InterferenceCheckTestVisibleModelPairs}" Content="{loc:Loc Ui.Main.Interference}" />
                <ToggleButton Style="{StaticResource ModeButton}" IsChecked="{Binding SectionEnabled}"
                              Visibility="{Binding QuickBar[Section].IsChecked, Converter={StaticResource BoolToVis}}"
                              ToolTip="{loc:Loc Ui.Main.ToggleSectionViewItsControls}" Content="{loc:Loc Ui.Main.ToolbarSection}" />
                <Button Style="{StaticResource QuickButton}" Command="{Binding ClearMeasurementsCommand}"
                        Visibility="{Binding QuickBar[Clear].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.ClearAllMeasurementsMarkersEscCancels}" Content="{loc:Loc Ui.Main.Clear}" />
                <ToggleButton Style="{StaticResource ModeButton}" IsChecked="{Binding UseInch}"
                              Visibility="{Binding QuickBar[Unit].IsChecked, Converter={StaticResource BoolToVis}}"
                              ToolTip="{loc:Loc Ui.Main.SwitchDisplayUnitsBetweenMmInches}">mm ⇄ in</ToggleButton>
                <Button Style="{StaticResource QuickButton}" Command="{Binding ExportCsvCommand}"
                        Visibility="{Binding QuickBar[ExportCsv].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.ExportMeasurementResultsCSV}">💾 CSV</Button>
                <Button Style="{StaticResource QuickButton}" Command="{Binding SaveScreenshotCommand}"
                        Visibility="{Binding QuickBar[Screenshot].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.SavePNGScreenshot3DView2}" Content="{loc:Loc Ui.Main.Capture}" />
                <Button Style="{StaticResource QuickButton}" Command="{Binding ExportStepFileCommand}"
                        Visibility="{Binding QuickBar[ExportStep].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.ToolbarExportStepTooltip}">📤 STEP</Button>
                <Button Style="{StaticResource QuickButton}" Command="{Binding ExportStlFileCommand}"
                        Visibility="{Binding QuickBar[ExportStl].IsChecked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Loc Ui.Main.ToolbarExportStlTooltip}">📐 STL</Button>
                <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Key"
                          SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Id"
                          Visibility="{Binding QuickBar[Language].IsChecked, Converter={StaticResource BoolToVis}}"
                          ToolTip="{loc:Loc Ui.Language}" Margin="2,0" />
            </ToolBar>
        </ToolBarTray>

        <!-- ─── 剖面參數列（只在剖面開啟時出現）─── -->
        <ToolBarTray DockPanel.Dock="Top"
                     Visibility="{Binding SectionEnabled, Converter={StaticResource BoolToVis}}">
            <ToolBar>
                <TextBlock Text="{loc:Loc Ui.Main.SectionLabel}" VerticalAlignment="Center" Margin="4,0,2,0" />
                <ComboBox SelectedIndex="{Binding SectionAxisIndex}" Width="60" Margin="4,0"
                          VerticalAlignment="Center" ToolTip="{loc:Loc Ui.Main.SectionAxis3PointsDefineAn}">
                    <ComboBoxItem>X</ComboBoxItem>
                    <ComboBoxItem>Y</ComboBoxItem>
                    <ComboBoxItem>Z</ComboBoxItem>
                    <ComboBoxItem Content="{loc:Loc Ui.Main.3Points}" />
                </ComboBox>
                <Slider Value="{Binding SectionPosition}" Minimum="0" Maximum="100" Width="180"
                        VerticalAlignment="Center" Margin="4,0" ToolTip="{loc:Loc Ui.Main.SectionPositionAlongNormal}" />
                <TextBox Text="{Binding SectionPosition, StringFormat={}{0:F0}}" Width="34"
                         VerticalAlignment="Center" ToolTip="{loc:Loc Ui.Main.SectionPosition0100EnterValue}" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="1,0,0,0" />
                <CheckBox IsChecked="{Binding SectionFlip}" Content="{loc:Loc Ui.Main.Flip}" VerticalAlignment="Center"
                          Margin="4,0" ToolTip="{loc:Loc Ui.Main.SwitchRetainedSide}" />
                <Button Style="{StaticResource QuickButton}" Command="{Binding CloseSectionCommand}"
                        ToolTip="{loc:Loc Ui.Main.CloseSectionView}" Content="{loc:Loc Ui.Main.Close}" />
            </ToolBar>
        </ToolBarTray>

        <!-- ─── 狀態列 ─── -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="140" Height="13" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" MinWidth="160" />
            </Grid.ColumnDefinitions>

            <!-- ─── 裝配樹面板 ─── -->
            <GroupBox Grid.Column="0" Header="{loc:Loc Ui.Main.ModelsAssemblyTree}" Margin="4">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" Margin="0,2,0,4"
                             Text="{Binding TreeFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{loc:Loc Ui.Main.FilterAssemblyTreeByNameDoes}" />
                    <TreeView ItemsSource="{Binding Roots}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              SelectedItemChanged="Tree_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Visibility"
                                        Value="{Binding IsFilterVisible, Converter={StaticResource BoolToVis}}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:ModelNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1"
                                            Background="Transparent"
                                            ToolTip="{Binding ToolTipText}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Loc Ui.Main.ShowOnlyThisNode}"
                                                      Command="{Binding PlacementTarget.Tag.IsolateNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="{loc:Loc Ui.Main.InvertVisibility}"
                                                      Command="{Binding PlacementTarget.Tag.InvertVisibilityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{loc:Loc Ui.Main.ShowAll}"
                                                      Command="{Binding PlacementTarget.Tag.ShowAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="{loc:Loc Ui.Main.MeasureVolumeCentroid}"
                                                      Command="{Binding PlacementTarget.Tag.MeasureVolumeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Ui.Main.ShowHideIncludingChildNodes}" />
                                    <Button Width="14" Height="14" Margin="3,0"
                                            VerticalAlignment="Center" ToolTip="{loc:Loc Ui.Main.ClickChangeColorIncludingChildNodes}"
                                            Command="{Binding CycleColorCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding Color}" />
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               MaxWidth="130" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <CheckBox IsChecked="{Binding ShowEdges}" Content="{loc:Loc Ui.Main.Edges}" FontSize="10"
                                              VerticalAlignment="Center" Margin="4,0,0,0"
                                              Visibility="{Binding IsRoot, Converter={StaticResource BoolToVis}}"
                                              ToolTip="{loc:Loc Ui.Main.ShowOutlineEdgesManyEdgesCan}" />
                                    <Button Content="🔍" Width="20" Margin="3,0,0,0" Padding="0"
                                            VerticalAlignment="Center" ToolTip="{loc:Loc Ui.Main.ZoomThisNode}"
                                            Command="{Binding DataContext.ZoomNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="✕" Width="20" Padding="0" Margin="2,0,0,0"
                                            VerticalAlignment="Center" ToolTip="{loc:Loc Ui.Main.RemoveThisFile}"
                                            Visibility="{Binding IsRoot, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RemoveRootCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="#FFD8D8D8"
                          ToolTip="{loc:Loc Ui.Main.DragResizePanel}" />

            <!-- ─── 3D 視圖 ─── -->
            <h:HelixViewport3D x:Name="viewport" Grid.Column="2"
                               ShowViewCube="True" ShowCoordinateSystem="True"
                               ShowFrameRate="False" ZoomExtentsWhenLoaded="True"
                               PanGesture="MiddleClick" PanGesture2="Shift+LeftClick"
                               MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                               MouseMove="Viewport_MouseMove"
                               MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                               LostMouseCapture="Viewport_LostMouseCapture">
                <h:HelixViewport3D.Style>
                    <Style TargetType="h:HelixViewport3D">
                        <Style.Triggers>
                            <DataTrigger Value="True"
                                         Binding="{Binding CurrentMode, Converter={StaticResource ModeConv}, ConverterParameter=Drag}">
                                <Setter Property="Cursor" Value="Hand" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </h:HelixViewport3D.Style>
                <h:HelixViewport3D.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFEAF2F8" Offset="0" />
                        <GradientStop Color="#FFB9C9D4" Offset="1" />
                    </LinearGradientBrush>
                </h:HelixViewport3D.Background>
                <h:DefaultLights />
            </h:HelixViewport3D>

            <!-- 操作器疊圖層：透明 Viewport3D 疊在主視窗上、永遠最上層。
                 只在操作器開啟時 IsHitTestVisible（否則空白處滑鼠才會穿透回主視窗） -->
            <Viewport3D x:Name="gizmoOverlay" Grid.Column="2"
                        IsHitTestVisible="{Binding GizmoEnabled}" />

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="#FFD8D8D8"
                          ToolTip="{loc:Loc Ui.Main.DragResizePanel}" />

            <!-- ─── 量測結果面板 ─── -->
            <GroupBox Grid.Column="4" Header="{loc:Loc Ui.Main.Measurements}" Margin="4">
                <ListBox ItemsSource="{Binding Measurements}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#FF555555"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕" Width="22" Height="22"
                                        VerticalAlignment="Top" ToolTip="{loc:Loc Ui.Main.DeleteThisMeasurement}"
                                        Command="{Binding DataContext.RemoveMeasurementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
